# Openweek configuration. Copy to `.env` and fill in. Generate secrets with: openssl rand -base64 32
# The app validates these at boot (server/utils/config.ts) and fails fast if anything is missing.

# --- Required ---
DATABASE_URL=postgres://openweek:openweek@localhost:5432/openweek
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# base64 of exactly 32 bytes — encrypts calendar tokens at rest. Back this up; losing it forces reconnects.
OPENWEEK_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# --- Optional: Google sign-in and/or Google Calendar sync ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: local Postgres host port (docker compose reads this file too) ---
# Only the host side; the container always listens on 5432. Give each checkout/worktree its own
# port and keep it in sync with DATABASE_URL above, or `pnpm db:up` fails with "port is already
# allocated" when two of them run at once.
OPENWEEK_DB_PORT=5432

# --- Optional: calendar sync tuning ---
OPENWEEK_SYNC_INTERVAL=15m
OPENWEEK_EVENT_WINDOW=-1w..+6w
