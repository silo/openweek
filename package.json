{
  "name": "openweek-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": "^24",
    "pnpm": "^10"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U openweek -d openweek",
    "db:reset": "docker compose down -v && pnpm run db:up && pnpm run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:gen": "npx --yes @better-auth/cli@latest generate --config server/utils/auth.ts --output server/database/schema/auth.ts --yes"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@googleapis/calendar": "^16.0.0",
    "@pinia/nuxt": "^1.0.2",
    "better-auth": "^1.7.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fractional-indexing-jittered": "^1.0.0",
    "google-auth-library": "^11.0.2",
    "ical.js": "^2.2.1",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "pinia": "^4.0.3",
    "tsdav": "^2.3.1",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
